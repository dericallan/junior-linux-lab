rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Each student's saved terminal VM state, one object per student,
    // keyed by their Firebase Auth uid. Only that student can read/write
    // their own — the mentor doesn't need this for anything today.
    match /terminal-states/{uid}.bin {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
